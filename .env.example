# These are examples, not secrets. Node does not read this file automatically.
# Windows PowerShell: $env:HOST="0.0.0.0"; npm run server
# macOS/Linux: HOST=0.0.0.0 npm run server
HOST=127.0.0.1
PORT=8787
DATA_FILE=./data/block-league.json
WEB_DIR=./app/web-dist
# Enable only for explicit development reward simulation.
ALLOW_TEST_REWARDS=0
# Optional comma-separated browser origins; native apps send no browser Origin.
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
