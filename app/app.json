{
  "expo": {
    "name": "Block League",
    "slug": "block-league",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blockleague.pilot"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#233942"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.blockleague.pilot"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-font"
    ],
    "scheme": "blockleague"
  }
}